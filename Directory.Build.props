<Project>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Authors>Dimitar Nanov</Authors>
    <RepositoryUrl>https://github.com/nanov/Nanov.OpenTelemetry.Summary</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    Dependencies follow the target framework, so each TFM gets the Microsoft.Extensions.* / DiagnosticSource line
    of its own runtime. OpenTelemetry 1.21 dropped its net9.0 build (net9.0 would fall back to netstandard2.1
    with 11.0 dependencies), so net9.0 stays on 1.20.1, the last release built for it.
  -->
  <PropertyGroup>
    <OpenTelemetryVersion>1.21.0</OpenTelemetryVersion>
    <OpenTelemetryVersion Condition="'$(TargetFramework)' == 'net9.0'">1.20.1</OpenTelemetryVersion>
  </PropertyGroup>

</Project>
